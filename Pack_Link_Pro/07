      let crmDealId = null;

      let zohoSdkAvailable = false;



      function setCrmStatus(message) {

        const el = document.getElementById("crmStatus");

        if (el) el.textContent = message;

      }



      function resizeZohoWidget() {

        if (

          !window.ZOHO ||

          !ZOHO.CRM ||

          !ZOHO.CRM.UI ||

          typeof ZOHO.CRM.UI.Resize !== "function"

        ) {

          console.warn("Zoho CRM resize API is not available in this context.");

          return;

        }

        ZOHO.CRM.UI.Resize({ height: "800", width: "1200" })

          .then(function (response) {

            console.log("Widget resize response:", response);

          })

          .catch(function (error) {

            console.warn("Widget resize request failed:", error);

          });

      }



      if (window.ZOHO && ZOHO.embeddedApp) {

        zohoSdkAvailable = true;



        ZOHO.embeddedApp.on("PageLoad", function (data) {

          console.log("Zoho CRM PageLoad data:", data);



          if (data && Array.isArray(data.EntityId)) {

            crmDealId = data.EntityId.length ? String(data.EntityId[0]) : null;

          } else if (data && data.EntityId != null) {

            crmDealId = String(data.EntityId);

          } else {

            crmDealId = null;

          }



          console.log("CRM Deal ID:", crmDealId);

          window.crmDealId = crmDealId;

          setCrmStatus(

            crmDealId

              ? "Connected to Zoho CRM · Deal ID: " + crmDealId

              : "Zoho CRM loaded · No Deal ID was supplied in PageLoad data.",

          );

          resizeZohoWidget();

        });



        ZOHO.embeddedApp.init();

      } else {

        console.warn(

          "Zoho Embedded App SDK not detected. Open this page inside a Zoho CRM widget to receive the Deal ID.",

        );

        setCrmStatus(

          "Standalone preview · Open inside Zoho CRM to receive the current Deal ID.",

        );

      }



      // Shipping rates are loaded dynamically from the Packlink PRO response.

      let currentRates = [];

      let activeFilter = "all";



      const $ = (id) => document.getElementById(id);

      function showToast(message, type) {

        const toast = $("toast");

        toast.textContent = message;

        toast.className = "toast" + (type === "error" ? " error" : "");

        toast.classList.remove("hidden");

        window.clearTimeout(showToast.timer);

        showToast.timer = window.setTimeout(

          () => toast.classList.add("hidden"),

          3200,

        );

      }

      function validPositive(id) {

        const el = $(id);

        const number = Number(el.value);

        if (!el.value.trim() || !Number.isFinite(number) || number <= 0) {

          el.focus();

          el.reportValidity && el.reportValidity();

          return false;

        }

        return true;

      }

      function validateShipment() {

        const textIds = [

          "fromName",

          "fromAddress",

          "fromCity",

          "fromPostcode",

          "toName",

          "toAddress",

          "toCity",

          "toPostcode",

        ];

        for (const id of textIds) {

          if (!$(id).value.trim()) {

            $(id).focus();

            showToast(

              "Please complete all required sender and recipient fields.",

              "error",

            );

            return false;

          }

        }

        for (const id of ["weight", "length", "width", "height"]) {

          if (!validPositive(id)) {

            showToast(

              "Weight and dimensions must be greater than zero.",

              "error",

            );

            return false;

          }

        }

        return true;

      }



      function escapeHtml(value) {

        return String(value == null ? "" : value)

          .replace(/&/g, "&amp;")

          .replace(/</g, "&lt;")

          .replace(/>/g, "&gt;")

          .replace(/"/g, "&quot;")

          .replace(/'/g, "&#39;");

      }



      function firstValue(obj, keys, fallback) {

        if (!obj || typeof obj !== "object") return fallback;

        for (const key of keys) {

          const value = obj[key];

          if (value !== undefined && value !== null && value !== "") return value;

        }

        return fallback;

      }



      function parseMaybeJson(value) {

        if (typeof value !== "string") return value;

        const trimmed = value.trim();

        if (!trimmed) return value;

        try { return JSON.parse(trimmed); } catch (_) { return value; }

      }



      function unwrapFunctionResponse(raw) {

        let value = parseMaybeJson(raw);

        // ZOHO.CRM.HTTP.post may wrap the Deluge string output.

        for (let i = 0; i < 4 && value && typeof value === "object"; i++) {

          if (value.details && value.details.output !== undefined) {

            value = parseMaybeJson(value.details.output);

            continue;

          }

          if (value.response !== undefined && Object.keys(value).length <= 5) {

            value = parseMaybeJson(value.response);

            continue;

          }

          if (value.output !== undefined && Object.keys(value).length <= 5) {

            value = parseMaybeJson(value.output);

            continue;

          }

          break;

        }

        return value;

      }



      // Detect only an explicit Bad Request response. Valid service arrays such as Array(15) pass through unchanged.
      function isBadRequestResponse(value) {
        value = parseMaybeJson(value);
        if (typeof value === "string") {
          const text = value.trim();
          if (/^bad request$/i.test(text)) return true;
          if ((text.startsWith("{") && text.endsWith("}")) || (text.startsWith("[") && text.endsWith("]"))) {
            try { return isBadRequestResponse(JSON.parse(text)); } catch (_) { return false; }
          }
          return false;
        }
        if (Array.isArray(value)) {
          return value.length > 0 && value.every(item => isBadRequestResponse(item));
        }
        if (!value || typeof value !== "object") return false;
        for (const key of ["message", "error", "statusMessage"]) {
          if (typeof value[key] === "string" && /^bad request$/i.test(value[key].trim())) return true;
        }
        for (const key of ["output", "response", "data", "result", "details"]) {
          if (value[key] !== undefined && isBadRequestResponse(value[key])) return true;
        }
        return false;
      }

      function showNoShippingOptions(shipment) {
        currentRates = [];
        $("summaryLine").textContent = `${shipment.parcel_type} · ${shipment.from_city} → ${shipment.to_city} · ${shipment.weight} kg · ${shipment.length} × ${shipment.width} × ${shipment.height} cm`;
        $("summaryAddress").textContent = `${shipment.from_postcode}, ${shipment.from_country} → ${shipment.to_postcode}, ${shipment.to_country}`;
        $("resultCount").textContent = "No shipping services available";
        $("rateList").innerHTML = '<div class="empty"><strong>No shipping options available</strong><br>Packlink PRO did not return any shipping services for these shipment details. Please check the addresses, postcodes, weight and dimensions, then try again.</div>';
        $("detailsScreen").classList.add("hidden");
        $("ratesScreen").classList.remove("hidden");
        $("step1").classList.remove("active");
        $("step1").classList.add("done");
        $("step1").querySelector(".step-num").textContent = "✓";
        $("step2").classList.add("active");
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function findServiceArray(data) {

        if (Array.isArray(data)) return data;

        if (!data || typeof data !== "object") return null;



        const preferredKeys = [

          "services", "data", "results", "items", "rates",

          "available_services", "availableServices", "shipping_services"

        ];

        for (const key of preferredKeys) {

          if (Array.isArray(data[key])) return data[key];

        }

        for (const value of Object.values(data)) {

          if (Array.isArray(value) && value.length &&

              value.some(item => item && typeof item === "object" &&

                ("base_price" in item || "price" in item || "carrier_name" in item ||

                 "service_name" in item || "transit_time" in item))) {

            return value;

          }

        }

        return null;

      }



      function asBoolean(value) {
        if (value === true || value === 1) return true;
        if (value === false || value === 0 || value == null) return false;
        const text = String(value).trim().toLowerCase();
        if (text === "true" || text === "yes" || text === "1") return true;
        if (text === "false" || text === "no" || text === "0" || text === "") return false;
        return null;
      }

      function parseApiBoolean(value) {
        if (value === true || value === 1) return true;
        if (value === false || value === 0) return false;
        if (value == null || value === "") return null;
        const text = String(value).trim().toLowerCase();
        if (["true", "yes", "1"].includes(text)) return true;
        if (["false", "no", "0"].includes(text)) return false;
        return null;
      }

      function getShippingMethods(service) {
        const senderMethod = service.dropoff === true
          ? "DROP-OFF POINT"
          : service.dropoff === false
            ? "COURIER COLLECTION"
            : "SENDER METHOD NOT SPECIFIED";

        const deliveryMethod = service.parcelShopDelivery === true
          ? "DELIVERY TO PICK-UP POINT"
          : service.parcelShopDelivery === false
            ? "HOME DELIVERY"
            : "DELIVERY METHOD NOT SPECIFIED";

        return { senderMethod, deliveryMethod };
      }

      function normalizeService(raw, index) {
        raw = raw && typeof raw === "object" ? raw : {};
        const carrierValue = firstValue(raw, ["carrier_name", "carrier", "provider_name", "provider", "company"], null);
        const serviceValue = firstValue(raw, ["name", "service_name", "service", "product_name"], null);
        const rawPrice = firstValue(raw, ["base_price", "price", "total_price", "amount"], null);
        const numericPrice = rawPrice === null ? null : Number(rawPrice);
        const currencyValue = firstValue(raw, ["currency", "currency_code"], null);
        const transitValue = firstValue(raw, ["transit_time", "transitTime", "delivery_time", "deliveryTime", "estimated_delivery", "delivery_estimate"], null);
        // Dates may be returned at the top level or nested inside Packlink's
        // delivery/collection option objects. Search the actual response keys
        // recursively so date field naming/nesting does not hide valid dates.
        function findDateByKeyHints(object, hints, depth) {
          if (!object || typeof object !== "object" || depth > 5) return null;
          if (Array.isArray(object)) {
            for (const item of object) {
              const found = findDateByKeyHints(item, hints, depth + 1);
              if (found !== null && found !== undefined && found !== "") return found;
            }
            return null;
          }
          for (const [key, value] of Object.entries(object)) {
            const normalizedKey = key.toLowerCase().replace(/[^a-z0-9]/g, "");
            const isDateKey = /date|day|deliveryestimate|estimateddelivery|eta/.test(normalizedKey);
            if (isDateKey && hints.some(hint => normalizedKey.includes(hint)) &&
                (typeof value === "string" || typeof value === "number") && String(value).trim()) {
              return value;
            }
          }
          for (const value of Object.values(object)) {
            if (value && typeof value === "object") {
              const found = findDateByKeyHints(value, hints, depth + 1);
              if (found !== null && found !== undefined && found !== "") return found;
            }
          }
          return null;
        }
        const collectionDateRaw = firstValue(raw, [
          "collection_date", "collectionDate", "pickup_date", "pickupDate",
          "courier_collection_date", "courierCollectionDate", "sender_pickup_date",
          "collection_estimated_date", "pickup_estimated_date", "collection_day", "pickup_day"
        ], findDateByKeyHints(raw, ["collection", "courierpickup", "senderpickup", "pickup"], 0));
        const homeDeliveryDateRaw = firstValue(raw, [
          "home_delivery_date", "homeDeliveryDate", "delivery_date", "deliveryDate",
          "estimated_delivery_date", "estimatedDeliveryDate", "delivery_estimated_date",
          "recipient_delivery_date", "arrival_date", "delivery_day", "home_delivery_day"
        ], findDateByKeyHints(raw, ["homedelivery", "recipientdelivery", "deliverydate", "estimateddelivery", "arrival"], 0));
        const parcelShopDateRaw = firstValue(raw, [
          "parcelshop_delivery_date", "parcelShopDeliveryDate", "parcel_shop_delivery_date",
          "pickup_point_delivery_date", "pickupPointDeliveryDate", "dropoff_point_delivery_date",
          "delivery_to_parcelshop_date", "delivery_to_pickup_point_date", "parcelshop_delivery_day"
        ], findDateByKeyHints(raw, ["parcelshop", "pickuppoint", "deliverytopickup", "deliverytoparcelshop", "accesspoint"], 0));

        // Packlink may return a delivery window as separate FROM/TO dates.
        // Read those exact fields as well as common API naming variants.
        const dateFromRaw = firstValue(raw, [
          "from_date", "fromDate", "date_from", "dateFrom", "delivery_date_from",
          "deliveryDateFrom", "estimated_delivery_from", "estimatedDeliveryFrom",
          "delivery_from_date", "deliveryFromDate", "date_start", "dateStart",
          "delivery_date_start", "deliveryDateStart", "start_date", "startDate"
        ], findDateByKeyHints(raw, ["deliverydatefrom", "estimateddeliveryfrom", "deliveryfromdate", "deliverydatestart", "startdate", "datefrom"], 0));
        const dateToRaw = firstValue(raw, [
          "to_date", "toDate", "date_to", "dateTo", "delivery_date_to",
          "deliveryDateTo", "estimated_delivery_to", "estimatedDeliveryTo",
          "delivery_to_date", "deliveryToDate", "date_end", "dateEnd",
          "delivery_date_end", "deliveryDateEnd", "end_date", "endDate"
        ], findDateByKeyHints(raw, ["deliverydateto", "estimateddeliveryto", "deliverytodate", "deliverydateend", "enddate", "dateto"], 0));

        const dropoffRaw = firstValue(raw, ["dropoff", "drop_off", "dropoff_available", "drop_off_available"], null);
        const collectionRaw = firstValue(raw, ["collection", "pickup", "pickup_available", "collection_available"], null);
        const homeRaw = firstValue(raw, ["home_delivery", "delivery_to_address", "door_delivery"], null);
        const parcelShopRaw = firstValue(raw, ["delivery_to_parcelshop", "delivery_to_parcel_shop", "parcelshop_delivery"], null);
        const dropoff = parseApiBoolean(dropoffRaw);
        const collection = parseApiBoolean(collectionRaw);
        const homeDelivery = parseApiBoolean(homeRaw);
        const parcelShopDelivery = parseApiBoolean(parcelShopRaw);

        // Only infer filter tags from explicit API fields or the actual service/carrier name.
        const nameText = String((carrierValue || "") + " " + (serviceValue || "")).toLowerCase();
        const tags = [];
        if (dropoff === true || /drop.?off|parcel.?shop|access point|locker/.test(nameText)) tags.push("dropoff");
        if (dropoff === false || collection === true || /collection|pickup from sender|door.?to.?door/.test(nameText)) tags.push("collection");
        if (parcelShopDelivery === false || homeDelivery === true) tags.push("home");
        if (parcelShopDelivery === true) tags.push("parcelshop");
        // Only apply the 24–48h filter when the API explicitly returns a numeric hour/day estimate.
        if (transitValue != null) {
          const transitText = String(transitValue).toLowerCase();
          const numberMatch = transitText.match(/\d+(?:\.\d+)?/);
          if (numberMatch) {
            const n = Number(numberMatch[0]);
            if ((/hour|hr|\bh\b/.test(transitText) && n <= 48) || (/day|days/.test(transitText) && n <= 2)) tags.push("fast");
          }
        }

        const labelsRequired = firstValue(raw, ["labels_required", "label_required"], null);
        const printerRequired = firstValue(raw, ["printer_required", "requires_printer", "label_printer_required"], null);
        const insurance = firstValue(raw, ["insurance", "compensation", "compensation_limit", "cover"], null);
        // Some Packlink responses use only a generic delivery_date. Route it to
        // the displayed destination column based on the method flags.
        const genericDeliveryDate = firstValue(raw, ["delivery_date", "deliveryDate", "estimated_delivery_date", "estimatedDeliveryDate", "delivery_day"], null);

        // Packlink's live response supplies its actual date options as an object:
        // available_dates: { "2026/10/26": "[08:00 , 20:30]", ... }.
        // These are date-keyed values, not fields named delivery_date, so extract
        // the keys directly. Transit time determines which available date is the
        // estimated destination date (e.g. 1 DAYS => second available date).
        const availableDatesObject = firstValue(raw, ["available_dates", "availableDates", "delivery_dates", "deliveryDates"], null);
        const availableDateKeys = availableDatesObject && typeof availableDatesObject === "object" && !Array.isArray(availableDatesObject)
          ? Object.keys(availableDatesObject).filter(key => /^\d{4}[/-]\d{2}[/-]\d{2}$/.test(key)).sort((a, b) => {
              const parse = value => new Date(value.replace(/\//g, "-") + "T00:00:00").getTime();
              return parse(a) - parse(b);
            })
          : [];
        const transitMatch = String(transitValue == null ? "" : transitValue).match(/(\d+(?:\.\d+)?)/);
        const transitDays = transitMatch ? Math.max(0, Math.ceil(Number(transitMatch[1]))) : 0;
        const estimatedAvailableDate = availableDateKeys.length
          ? availableDateKeys[Math.min(transitDays, availableDateKeys.length - 1)]
          : null;
        const availableDateFrom = availableDateKeys.length ? availableDateKeys[0] : null;
        const availableDateTo = availableDateKeys.length ? availableDateKeys[availableDateKeys.length - 1] : null;

        const resolvedParcelShopDate = parcelShopDateRaw != null ? parcelShopDateRaw : (parcelShopDelivery === true ? (genericDeliveryDate || estimatedAvailableDate) : null);
        const resolvedHomeDeliveryDate = homeDeliveryDateRaw != null ? homeDeliveryDateRaw : (parcelShopDelivery === false || homeDelivery === true ? (genericDeliveryDate || estimatedAvailableDate) : null);

        return {
          id: String(firstValue(raw, ["id", "service_id", "serviceId", "code"], index + 1)),
          raw,
          carrier: carrierValue == null ? null : String(carrierValue),
          logo: carrierValue == null ? null : String(carrierValue),
          logoClass: /ups/i.test(String(carrierValue || "")) ? "ups" : (/evri/i.test(String(carrierValue || "")) ? "evri" : (/dhl/i.test(String(carrierValue || "")) ? "dhl" : (/fedex/i.test(String(carrierValue || "")) ? "fedex" : ""))),
          service: serviceValue == null ? null : String(serviceValue),
          eta: transitValue == null ? null : String(transitValue),
          etaSort: (() => { const m = String(transitValue == null ? "" : transitValue).match(/\d+(?:\.\d+)?/); return m ? Number(m[0]) : Infinity; })(),
          price: Number.isFinite(numericPrice) ? numericPrice : null,
          currency: currencyValue == null ? null : String(currencyValue),
          dropoff, collection, homeDelivery, parcelShopDelivery,
          collectionDate: collectionDateRaw == null ? null : String(collectionDateRaw),
          homeDeliveryDate: resolvedHomeDeliveryDate == null ? null : String(resolvedHomeDeliveryDate),
          parcelShopDate: resolvedParcelShopDate == null ? null : String(resolvedParcelShopDate),
          deliveryDateFrom: dateFromRaw == null ? (estimatedAvailableDate || null) : String(dateFromRaw),
          deliveryDateTo: dateToRaw == null ? (estimatedAvailableDate || null) : String(dateToRaw),
          availableDateFrom: availableDateFrom,
          availableDateTo: availableDateTo,
          availableDates: availableDatesObject,
          labelsRequired: asBoolean(labelsRequired),
          printerRequired: asBoolean(printerRequired),
          insurance,
          tags
        };
      }

      function formatServiceDate(value) {
        if (value === undefined || value === null || value === "") return "";
        const text = String(value).trim();
        if (!text) return "";
        // Preserve non-standard date text; format ISO/date values for readability.
        const match = text.match(/^(\d{4})-(\d{2})-(\d{2})(?:[T\s].*)?$/);
        if (match) {
          const date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
          if (!Number.isNaN(date.getTime())) {
            return new Intl.DateTimeFormat("en-GB", {
              weekday: "short", day: "numeric", month: "long"
            }).format(date);
          }
        }
        return text;
      }

      function formatDeliveryWindow(service, fallbackDate) {
        const from = service && service.deliveryDateFrom;
        const to = service && service.deliveryDateTo;
        if (from && to) {
          const fromText = formatServiceDate(from);
          const toText = formatServiceDate(to);
          return fromText === toText ? fromText : `${fromText} – ${toText}`;
        }
        if (from) return `From ${formatServiceDate(from)}`;
        if (to) return `Until ${formatServiceDate(to)}`;
        return fallbackDate ? formatServiceDate(fallbackDate) : "";
      }

