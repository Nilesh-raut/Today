        if (!PACKLINK_COLLECTION_CRM_FUNCTION_URL || PACKLINK_COLLECTION_CRM_FUNCTION_URL === "PASTE_COLLECTION_CRM_FUNCTION_URL_HERE") {
          showToast("Add your collection CRM function URL in PACKLINK_COLLECTION_CRM_FUNCTION_URL first.", "error");
          console.error("Collection CRM function URL is not configured.");
          return;
        }
        if (!window.ZOHO || !ZOHO.CRM || !ZOHO.CRM.HTTP || typeof ZOHO.CRM.HTTP.post !== "function") {
          showToast("Open this widget inside Zoho CRM to submit the collection payload.", "error");
          return;
        }

        // Build the direct shipment payload expected by the CRM/Deluge side.
        // No dropoff_point_id is included for courier collection.
        const splitName = (first, last) => ({ name: first || "", surname: last || "" });
        const splitCityPostcode = (value) => {
          const text = String(value || "").trim();
          // The booking screen stores city and postcode together; split a trailing UK-style postcode where possible.
          const match = text.match(/^(.*?)[,\s]+([A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2})$/i);
          if (match) return { city: match[1].trim(), zip_code: match[2].trim().toUpperCase() };
          return { city: text, zip_code: "" };
        };
        const fromLocation = splitCityPostcode(bookingData.sender.cityPostcode);
        const toLocation = splitCityPostcode(bookingData.recipient.cityPostcode);
        const selectedServiceId = selectedRaw.id || selectedRaw.service_id || selectedRaw.serviceId || null;
        const collectionDateInput = bookingData.collectionDate;
        const collectionDate = collectionDateInput ? collectionDateInput.replace(/-/g, "/") : "";
        const availableDates = selectedRaw.available_dates || selectedRaw.availableDates || {};
        const availableTimeForDate = collectionDate && availableDates[collectionDate] ? String(availableDates[collectionDate]) : "";
        const collectionTime = availableTimeForDate || bookingData.collectionTime || "";

        const shipmentPayload = {
          from: {
            ...splitName(bookingData.sender.firstName, bookingData.sender.lastName),
            company: bookingData.sender.company,
            street1: bookingData.sender.street,
            street2: bookingData.sender.unit,
            zip_code: fromLocation.zip_code,
            city: fromLocation.city,
            country: bookingData.sender.country,
            state: "",
            phone: bookingData.sender.phone,
            email: bookingData.sender.email
          },
          to: {
            ...splitName(bookingData.recipient.firstName, bookingData.recipient.lastName),
            company: bookingData.recipient.company,
            street1: bookingData.recipient.street,
            street2: bookingData.recipient.unit,
            zip_code: toLocation.zip_code,
            city: toLocation.city,
            country: bookingData.recipient.country,
            state: "",
            phone: bookingData.recipient.phone,
            email: bookingData.recipient.email
          },
          packages: [{
            weight: Number($("weight").value),
            length: Number($("length").value),
            width: Number($("width").value),
            height: Number($("height").value)
          }],
          service_id: selectedServiceId,
          collection_date: collectionDate,
          collection_time: collectionTime,
          content: $("parcelType").value,
          contentvalue: 100,
          contentValue_currency: "GBP",
          content_second_hand: false,
          priority: false,
          shipment_custom_reference: "ZOHO-COLLECTION-" + Date.now(),
          source: "zoho_crm"
        };

        if (!shipmentPayload.service_id) {
          showToast("Could not find the selected service ID. Please select the collection service again.", "error");
          console.error("Selected service object is missing an ID:", selectedRaw);
          return;
        }
        if (!shipmentPayload.collection_date) {
          showToast("Please select a collection date.", "error");
          return;
        }

        const request = {
          url: PACKLINK_COLLECTION_CRM_FUNCTION_URL,
          headers: { "Content-Type": "application/json" },
          body: {
            arguments: JSON.stringify({ shipment_data: JSON.stringify(shipmentPayload) })
          }
        };

        console.log("N--------------------------------------------------------------------------------------------------------N");
        
        console.log("========== COLLECTION PAYLOAD TO CRM ==========");
        console.log("Shipment payload:", shipmentPayload);
        console.log("Shipment payload JSON:", JSON.stringify(shipmentPayload, null, 2));
        console.log("CRM request:", request);

        const button = $("continueBookingBtn");
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = "Sending to CRM…";
        try {
          const response = await ZOHO.CRM.HTTP.post(request);
          console.log("Collection CRM raw response:", response);
          showToast("Collection payload sent to CRM. Check the browser console and CRM function logs.");
        } catch (error) {
          console.error("Failed to send collection payload to CRM:", error);
          showToast("Could not send collection payload to CRM. Check the console for details.", "error");
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });

      $("searchRatesBtn").addEventListener("click", searchRates);

      $("editDetailsBtn").addEventListener("click", backToDetails);

      $("sortRates").addEventListener("change", renderRates);

      $("resetParcel").addEventListener("click", () => {

        $("weight").value = "12";

        $("length").value = "60";

        $("width").value = "40";

        $("height").value = "30";

        $("parcelType").value = "Rolled rug";

        showToast("Sample rug parcel dimensions restored.");

      });

      document.querySelectorAll(".chip").forEach((button) => {

        button.addEventListener("click", () => {

          activeFilter = button.dataset.filter;

          document

            .querySelectorAll(".chip")

            .forEach((item) =>

              item.classList.toggle("selected", item === button),

            );

          renderRates();

        });

      });

    </script>

  </body>

</html>
