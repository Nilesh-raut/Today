<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Webhook Test</title>

    <script src="https://live.zwidgets.com/js-sdk/1.5/ZohoEmbededAppSDK.min.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 30px;
        }

        .container {
            max-width: 400px;
            margin: auto;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            margin-bottom: 15px;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #4f46e5;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
            background: #4338ca;
        }

        #response {
            margin-top: 20px;
            padding: 10px;
        }
    </style>
</head>

<body>

<div class="container">

    <h2>Webhook Test</h2>

    <label>Full Name</label>

    <input
        type="text"
        id="full_name"
        placeholder="Enter full name"
    >

    <button type="button" onclick="sendToWebhook()">
        Submit
    </button>

    <div id="response"></div>

</div>


<script>

const FLOW_WEBHOOK_URL = "https://flow.zoho.in/60021952577/flow/webhook/incoming?zapikey=1001.031e5db6bb418648f85ef49f24c81515.b75916fabdfd79e6251c96b2e011deb0&isdebug=false";



async function sendToWebhook() {

    const fullName = document
        .getElementById("full_name")
        .value
        .trim();

    if (!fullName) {
        document.getElementById("response").innerText =
            "Please enter your full name.";
        return;
    }

    const payload = {
        full_name: fullName
    };

    console.log("Sending payload:");
    console.log(payload);

    const request = {
        url: FLOW_WEBHOOK_URL,

        headers: {
            "Content-Type": "application/json"
        },

        body: payload
    };

    console.log("Sending request through ZOHO.CRM.HTTP...");

    ZOHO.CRM.HTTP.post(request)
        .then(function(response) {

            console.log("Webhook response:");
            console.log(response);

            document.getElementById("response").innerText =
                "Webhook called successfully!";

        })
        .catch(function(error) {

            console.error("Webhook error:");
            console.error(error);

            document.getElementById("response").innerText =
                "Webhook failed. Check Console.";

        });
}


ZOHO.embeddedApp.on(
    "PageLoad",
    function(data) {

        console.log("Zoho Widget loaded:", data);

    }
);


ZOHO.embeddedApp.init()
    .then(function() {

        console.log(
            "Zoho Widget initialized successfully."
        );

    })
    .catch(function(error) {

        console.error(
            "Zoho Widget initialization failed:",
            error
        );

    });

</script>

</body>
</html>
