    function removeItem(itemId) {

        const row =
            document.querySelector(
                `[data-item-id="${itemId}"]`
            );


        if (!row) {
            return;
        }


        const rows =
            document.querySelectorAll(
                ".item-row"
            );


        if (rows.length === 1) {

            showToast(
                "At least one item is required.",
                "error"
            );

            return;
        }


        row.remove();

        updateItemCount();
    }


    function updateItemCount() {

        const count =
            document.querySelectorAll(
                ".item-row"
            ).length;


        document.getElementById(
            "itemCount"
        ).innerText =
            `${count} ${count === 1 ? "item" : "items"}`;
    }


    /* =========================================================
       HELPER
    ========================================================= */

    function value(id) {

        return document
            .getElementById(id)
            .value
            .trim();
    }


    function escapeHtml(value) {

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    /* =========================================================
       GET ITEMS
    ========================================================= */

    function getItems() {

        const rows =
            document.querySelectorAll(
                ".item-row"
            );

        const items = [];


        rows.forEach(function(row) {

            items.push({

                quantity:
                    Number(
                        row.querySelector(
                            ".item-quantity"
                        ).value
                    ),

                name:
                    row.querySelector(
                        ".item-name"
                    ).value.trim(),

                sku:
                    row.querySelector(
                        ".item-sku"
                    ).value.trim(),

                unit_price:
                    Number(
                        row.querySelector(
                            ".item-price"
                        ).value
                    )

            });

        });


        return items;
    }


