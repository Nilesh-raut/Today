    /* =========================================================
       ITEM SUBFORM
    ========================================================= */

    let itemCounter = 0;


    function addItem(defaultValues = {}) {

        itemCounter++;

        const itemId = itemCounter;

        const container = document.getElementById(
                "itemsContainer"
            );


        const row =
            document.createElement("div");

        row.className = "item-row";

        row.dataset.itemId = itemId;


        row.innerHTML = `

            <div class="form-group">

                <label>
                    Item Name
                    <span class="required">*</span>
                </label>

                <input
                    type="text"
                    class="item-name"
                    placeholder="Item name"
                    value="${escapeHtml(
                        defaultValues.name || ""
                    )}"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    SKU
                    <span class="required">*</span>
                </label>

                <input
                    type="text"
                    class="item-sku"
                    placeholder="SKU"
                    value="${escapeHtml(
                        defaultValues.sku || ""
                    )}"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    Quantity
                    <span class="required">*</span>
                </label>

                <input
                    type="number"
                    class="item-quantity"
                    min="1"
                    value="${defaultValues.quantity || 1}"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    Unit Price
                    <span class="required">*</span>
                </label>

                <input
                    type="number"
                    class="item-price"
                    min="0"
                    step="0.01"
                    placeholder="0.00"
                    value="${defaultValues.unit_price || ""}"
                    required
                >

            </div>


            <div class="delete-container">

                <button
                    type="button"
                    class="btn-delete"
                    onclick="removeItem(${itemId})"
                    title="Remove item"
                >
                    🗑
                </button>

            </div>

        `;


        container.appendChild(row);

        updateItemCount();
    }


    function removeItem(itemId) {

        const row =
            document.querySelector(
                `[data-item-id="${itemId}"]`
            );


        if (!row) {
            return;
        }


        const rows =
            document.querySelectorAll(
                ".item-row"
            );


        if (rows.length === 1) {

            showToast(
                "At least one item is required.",
                "error"
            );

            return;
        }


        row.remove();

        updateItemCount();
    }


    function updateItemCount() {

        const count =
            document.querySelectorAll(
                ".item-row"
            ).length;


        document.getElementById(
            "itemCount"
        ).innerText =
            `${count} ${count === 1 ? "item" : "items"}`;
    }


    /* =========================================================
       HELPER
    ========================================================= */

    function value(id) {
        const field = document.getElementById(id);
        return field && field.value != null ? String(field.value).trim() : "";
    }


    function escapeHtml(value) {

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }


    /* =========================================================
       GET ITEMS
    ========================================================= */

    function getItems() {

        const rows =
            document.querySelectorAll(
                ".item-row"
            );

        const items = [];


        rows.forEach(function(row) {

            items.push({

                quantity:
                    Number(
                        row.querySelector(
                            ".item-quantity"
                        ).value
                    ),

                name:
                    row.querySelector(
                        ".item-name"
                    ).value.trim(),

                sku:
                    row.querySelector(
                        ".item-sku"
                    ).value.trim(),

                unit_price:
                    Number(
                        row.querySelector(
                            ".item-price"
                        ).value
                    )

            });

        });


        return items;
    }


    /* =========================================================
       BUILD SHIPMENT OBJECT
    ========================================================= */

    function buildShipmentPayload() {


        /* ============================================
           SHIP TO
        ============================================ */

        const shipTo = {

            name:
                value("to_name"),

            phone:
                value("to_phone"),

            email:
                value("to_email"),

            company_name:
                value("to_company"),

            address_line1:
                value("to_address1"),

            address_line2:
                value("to_address2"),

            address_line3:
                value("to_address3"),

            city_locality:
                value("to_city"),

            state_province:
                value("to_state"),

            postal_code:
                value("to_postal"),

            country_code:
                value("to_country").toUpperCase(),

            address_residential_indicator:
                value("to_residential")

        };


        /* ============================================
           SHIP FROM
        ============================================ */

        const shipFrom = {

            name:
                value("from_name"),

            phone:
                value("from_phone"),

            email:
                value("from_email"),

            company_name:
                value("from_company"),

            address_line1:
                value("from_address1"),

            address_line2:
                value("from_address2"),

            city_locality:
                value("from_city"),

            state_province:
                value("from_state"),

            postal_code:
                value("from_postal"),

            country_code:
                value("from_country").toUpperCase(),

            address_residential_indicator:
                value("from_residential")

        };


        /* ============================================
           PACKAGE
        ============================================ */

        const packageData = {

            weight: {

                value:
                    Number(
                        value("weight")
                    ),

                unit:
                    value("weight_unit")

            },

            dimensions: {

                unit:
                    value("dimension_unit"),

                length:
                    Number(
                        value("length")
                    ),

                width:
                    Number(
                        value("width")
                    ),

                height:
                    Number(
                        value("height")
                    )

            }

        };


        /* ============================================
           CUSTOMS ITEM
        ============================================ */

        const customsItem = {

            description:
                value("customs_description"),

            quantity:
                Number(
                    value("customs_quantity")
                ),

            value:
                Number(
                    value("customs_value")
                ),

            value_currency:
                value("customs_currency")
                    .toUpperCase(),

            country_of_origin:
                value("customs_origin")
                    .toUpperCase()

        };


        /* ============================================
           CUSTOMS
        ============================================ */

        const customs = {

            contents:
                value("customs_contents"),

            non_delivery:
                value("customs_non_delivery"),

            customs_items: [
                customsItem
            ]

        };


        /* ============================================
           FINAL PAYLOAD
        ============================================ */

        const shipment = {

            external_shipment_id:
                value("external_shipment_id"),

            shipment_number:
                value("shipment_number"),

            create_sales_order: true,

            service_code: "ups_worldwide_expedited",

            ship_to: shipTo,

            ship_from: shipFrom,

            packages: [
                packageData
            ],

            customs: customs,

            items: getItems()
        };



        return shipment;
    }


    /* =========================================================
       VALIDATION
    ========================================================= */

    function validateForm() {

        const requiredFields =
            document.querySelectorAll(
                "input[required], select[required]"
            );


        let valid = true;


        requiredFields.forEach(function(field) {

            field.classList.remove(
                "error"
            );


            if (!field.value.trim()) {

                field.classList.add(
                    "error"
                );

                valid = false;
            }

        });


        /* Email validation */

        const emails = [
            "to_email",
            "from_email"
        ];


        emails.forEach(function(id) {

            const field =
                document.getElementById(id);


            if (
                field.value &&
                !field.checkValidity()
            ) {

                field.classList.add(
                    "error"
                );

                valid = false;
            }

        });


        if (!valid) {

            showToast(
                "Please complete all required fields.",
                "error"
            );

            return false;
        }


        return true;
    }


