    /* =========================================================
       RESET
    ========================================================= */

    function resetForm() {

        if (
            !confirm(
                "Are you sure you want to reset the shipment form?"
            )
        ) {
            return;
        }


        document
            .querySelectorAll(
                "input"
            )
            .forEach(function(input) {

                if (
                    input.type !== "checkbox"
                ) {
                    input.value = "";
                }

            });


        const salesOrderToggle = document.getElementById("create_sales_order");
        if (salesOrderToggle) salesOrderToggle.checked = true;


        document
            .getElementById(
                "itemsContainer"
            )
            .innerHTML = "";


        itemCounter = 0;

        addItem();


        const weightUnitField = document.getElementById("weight_unit");
        if (weightUnitField) weightUnitField.value = "gram";


        const dimensionUnitField = document.getElementById("dimension_unit");
        if (dimensionUnitField) dimensionUnitField.value = "centimeter";


        document.getElementById(
                "customs_contents"
            )
            .value = "merchandise";


        document
            .getElementById(
                "customs_non_delivery"
            )
            .value = "return_to_sender";


        showToast(
            "Form has been reset.",
            "success"
        );
    }


    /* =========================================================
