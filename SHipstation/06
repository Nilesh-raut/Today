    ========================================================= */

    function showToast(
        message,
        type = "success"
    ) {

        const toast =
            document.getElementById(
                "toast"
            );


        toast.innerText =
            message;


        toast.className =
            `toast ${type} show`;


        setTimeout(function() {

            toast.classList.remove(
                "show"
            );

        }, 3000);
    }
   
